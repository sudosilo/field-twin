+  html += '<div class="question">Business miles</div><input type="text" id="dmBiz" inputmode="decimal" style="' + big + '" value="' + val(s.business, c.suggest !== undefined ? c.suggest : '') + '"' + (lock ? ' disabled' : '') + '>';
+  html += '<div class="meta-line" id="dmCheck" style="color:#b00020;"></div>';
