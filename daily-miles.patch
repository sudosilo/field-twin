+      if (i === -1) pick.push(id); else pick.splice(i, 1);
+      await dmSave(dk, { start: s.start, end: s.end, business: s.business, pick: pick, extra: s.extra, locked: false });
+      showDailyMilesDay(dk);
+    }));
+    document.getElementById('dmTicketBtn').addEventListener('click', async () => {
+      const q = document.getElementById('dmTicket').value.trim();
+      if (!q) { setStatus('type the ticket address first'); return; }
+      setStatus('looking up the ticket address');
+      let g = null;
+      try { g = await geocodeSmart(q); } catch (e) { g = null; }
+      const extra = s.extra.concat([{ addr: q, lat: g ? g.lat : null, lon: g ? g.lon : null }]);
+      await dmSave(dk, { start: s.start, end: s.end, business: s.business, pick: s.pick, extra: extra, locked: false });
+      setStatus(g ? 'ticket added' : 'ticket added, but the address was not found on the map');
+      showDailyMilesDay(dk);
+    });
+    document.getElementById('dmConfirm').addEventListener('click', async () => {
+      const a = num('dmStart'), b = num('dmEnd'), z = num('dmBiz');
+      if (a === null || b === null || z === null) { document.getElementById('dmCheck').textContent = 'Fill in start, end and business miles first.'; return; }
+      if (!check()) return;
+      await dmSave(dk, { start: a, end: b, business: z, pick: curPick(), extra: s.extra, locked: true });
+      setStatus(dmDayLabel(dk) + ' confirmed');
+      showDailyMilesDay(dk);
+    });
+  } else {
+    document.getElementById('dmUnlock').addEventListener('click', async () => {
+      await dmSave(dk, { start: s.start, end: s.end, business: s.business, pick: s.pick, extra: s.extra, locked: false });
+      setStatus(dmDayLabel(dk) + ' unlocked');
+      showDailyMilesDay(dk);
+    });
+  }
+}
+
+document.getElementById('dailyMilesBtn').addEventListener('click', () => {
+  const ov = document.getElementById('menuOverlay'); if (ov) ov.click();
+  showDailyMiles();
+});
+</script>
