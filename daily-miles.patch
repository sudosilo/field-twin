+  panel.innerHTML = html;
+  panel.scrollTop = 0;
+  panel.classList.add('open');
+
+  const num = id => { const v = parseFloat(String(document.getElementById(id).value).replace(/,/g, '')); return isFinite(v) ? v : null; };
