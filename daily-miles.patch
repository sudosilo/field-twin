+<script>
+// Daily miles: one report per workday with start, end and business miles.
+// The day starts at the day start point. Tickets are the stops work sent you to, matched to pins.
+// A stop with no odometer reading is filled from the real readings before and after it, using the
+// driving miles learned from your own odometer between places. Confirmed days lock and sync like entries.
+const DM_START_KEY = 'fieldTwinDayStart', DM_MARGIN_KEY = 'fieldTwinDmMargin';
+const DM_NEAR_M = 400, DM_PAIR_M = 600;
+const DM_SKIP = ['receipt', 'odometer', 'debrief', 'mileday', 'none'];
+const DM_WORK = ['amazon_locker', 'warehouse', 'printer_site'];
+
+function dmCrow(aLat, aLon, bLat, bLon) {
+  const R = 3958.8, k = Math.PI / 180;
+  const x = Math.sin((bLat - aLat) * k / 2) ** 2 + Math.cos(aLat * k) * Math.cos(bLat * k) * Math.sin((bLon - aLon) * k / 2) ** 2;
+  return 2 * R * Math.asin(Math.sqrt(x));
+}
+function dmNear(a, b, m) { return dmCrow(a.lat, a.lon, b.lat, b.lon) * 1609.34 <= m; }
+function dmDayLabel(dk, long) {
+  return new Date(dk + 'T12:00:00').toLocaleDateString([], long ? { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' } : { weekday: 'long', month: 'long', day: 'numeric' });
+}
+function dmClock(t) { return new Date(t).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); }
+
+function dmStartGet() {
+  const m = window.twinMeta && window.twinMeta.daystart;
+  if (m && isFinite(m.lat)) return m;
+  try { return JSON.parse(localStorage.getItem(DM_START_KEY) || 'null'); } catch (e) { return null; }
+}
+async function dmStartSet(p) {
+  try { if (p) localStorage.setItem(DM_START_KEY, JSON.stringify(p)); else localStorage.removeItem(DM_START_KEY); } catch (e) {}
+  if (window.twinMeta) window.twinMeta.daystart = p;
+  try { if (sb && cloudUser) await sb.auth.updateUser({ data: { daystart: p } }); } catch (e) {}
+}
+function dmMargin() { const v = parseFloat(localStorage.getItem(DM_MARGIN_KEY)); return isFinite(v) ? v : 2; }
+
+function dmRecord(dk) { return entries.find(e => e.category === 'mileday' && e.context === 'mileday ' + dk) || null; }
+function dmState(dk) {
+  const r = dmRecord(dk);
+  const a = r ? (r.answers || []) : [];
+  let t = {};
+  try { t = JSON.parse(a[3] || '{}') || {}; } catch (e) { t = {}; }
+  return {
+    rec: r,
+    start: a[0] !== undefined && a[0] !== '' ? parseFloat(a[0]) : null,
+    end: a[1] !== undefined && a[1] !== '' ? parseFloat(a[1]) : null,
+    business: a[2] !== undefined && a[2] !== '' ? parseFloat(a[2]) : null,
+    pick: Array.isArray(t.pick) ? t.pick : null,
+    extra: Array.isArray(t.extra) ? t.extra : [],
+    locked: a[4] === 'locked'
+  };
+}
+async function dmSave(dk, s) {
+  let e = dmRecord(dk);
+  const answers = [s.start === null ? '' : String(s.start), s.end === null ? '' : String(s.end), s.business === null ? '' : String(s.business),
+    JSON.stringify({ pick: s.pick, extra: s.extra }), s.locked ? 'locked' : ''];
+  if (!e) {
+    e = {
+      id: 'mileday-' + dk + '-' + TWIN_ID,
+      timestamp: new Date(dk + 'T23:58:00').toISOString(),
+      lat: null, lon: null,
+      addressLabel: 'Daily miles, ' + dmDayLabel(dk, true),
+      locSrc: 'none', placeType: 'mileday', confidence: 5, formType: 'category', category: 'mileday',
+      questions: ['Start mileage', 'End mileage', 'Business miles', 'Tickets', 'Status'],
+      answers: answers, context: 'mileday ' + dk, icon: '\u{1F4CF}', twinId: TWIN_ID
+    };
+    entries.unshift(e);
+    entries.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
+  } else {
+    e.answers = answers;
+    e.updatedAt = new Date().toISOString();
+    const dirty = getDirtyIds(); dirty.add(e.id); setDirtyIds(dirty);
+  }
+  await saveEntries().catch(() => {});
+}
+
+function dmReadings() {
+  entries.forEach(odoFromAnswers);
+  return entries.filter(e => e.category === 'odometer' && e.odometer && isFinite(e.odometer.reading))
+    .map(e => ({ id: e.id, t: new Date(e.timestamp).getTime(), r: e.odometer.reading, lat: e.lat, lon: e.lon, pos: hasPos(e) }))
+    .sort((a, b) => a.t - b.t);
+}
+
+// Driving miles between two places, learned from back to back odometer readings and from locked days.
+function dmPairs() {
+  const rs = dmReadings().filter(x => x.pos);
+  const pairs = [];
+  for (let i = 1; i < rs.length; i++) {
+    const a = rs[i - 1], b = rs[i];
+    const d = b.r - a.r, crow = dmCrow(a.lat, a.lon, b.lat, b.lon);
+    if (crow < 0.3 || b.t - a.t > 5 * 3600000) continue;
+    if (d < crow * 0.95 - 0.3 || d > crow * 2 + 4) continue;
+    pairs.push({ a: a, b: b, d: d });
+  }
+  const p = dmStartGet();
+  if (p) entries.filter(e => e.category === 'mileday' && (e.answers || [])[4] === 'locked').forEach(e => {
+    const dk = e.context.slice(8);
+    const c = dmCompute(dk, true);
+    if (c.stops.length && c.stops[0].odo && c.stops[0].odo.src === 'reading' && c.state.start !== null) {
+      const d = c.stops[0].odo.v - c.state.start;
+      const crow = dmCrow(p.lat, p.lon, c.stops[0].lat, c.stops[0].lon);
+      if (crow >= 0.3 && d >= crow * 0.95 - 0.3 && d <= crow * 2 + 4) pairs.push({ a: p, b: c.stops[0], d: d });
+    }
+  });
+  return pairs;
+}
+function dmDist(a, b, pairs) {
+  const crow = dmCrow(a.lat, a.lon, b.lat, b.lon);
+  if (crow * 1609.34 <= DM_NEAR_M) return { mi: 0, src: 'learned', n: 0 };
+  const hits = pairs.filter(p => (dmNear(p.a, a, DM_PAIR_M) && dmNear(p.b, b, DM_PAIR_M)) || (dmNear(p.a, b, DM_PAIR_M) && dmNear(p.b, a, DM_PAIR_M)));
+  if (hits.length) return { mi: hits.reduce((s, h) => s + h.d, 0) / hits.length, src: 'learned', n: hits.length };
+  return { mi: crow * 1.3, src: 'estimate', n: 0 };
+}
+
+// Stops on a day: pins grouped by place, in the order you reached them.
+function dmStops(dk) {
+  const list = entries.filter(e => e.timestamp && localDay(e.timestamp) === dk && hasPos(e) && DM_SKIP.indexOf(e.category) === -1)
+    .slice().sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));
+  const stops = [];
+  list.forEach(e => {
+    const span = typeof stopSpan === 'function' ? stopSpan(e) : [new Date(e.timestamp).getTime(), new Date(e.timestamp).getTime() + 1200000];
+    const last = stops[stops.length - 1];
+    if (last && dmNear(last, e, 250)) {
+      last.t1 = Math.max(last.t1, Math.min(span[1], span[0] + 6 * 3600000));
+      if (last.cats.indexOf(e.category) === -1) last.cats.push(e.category);
+      return;
+    }
+    stops.push({ id: e.id, lat: e.lat, lon: e.lon, t0: span[0], t1: Math.min(span[1], span[0] + 6 * 3600000), label: e.addressLabel || 'Stop', cats: [e.category] });
+  });
+  return stops;
+}
+
+function dmOdoAt(s, rs, pairs) {
+  const exact = rs.filter(x => x.pos && dmNear(x, s, DM_NEAR_M) && x.t >= s.t0 - 1200000 && x.t <= s.t1 + 1200000);
+  if (exact.length) return { v: exact[0].r, src: 'reading' };
+  const before = rs.filter(x => x.pos && x.t <= s.t0 && s.t0 - x.t < 36 * 3600000).pop();
+  const after = rs.filter(x => x.pos && x.t >= s.t0 && x.t - s.t0 < 36 * 3600000)[0];
+  let e1 = null, e2 = null;
+  if (before) e1 = before.r + dmDist(before, s, pairs).mi;
+  if (after) e2 = after.r - dmDist(s, after, pairs).mi;
+  const lo = before ? before.r : -Infinity, hi = after ? after.r : Infinity;
+  const clamp = v => Math.max(lo, Math.min(hi, v));
+  if (e1 !== null && e2 !== null) {
+    if (Math.abs(e1 - e2) <= 3) return { v: Math.round(clamp((e1 + e2) / 2)), src: 'filled' };
+    return { v: Math.round(clamp(e1)), src: 'filled', warn: 'the readings before and after this stop disagree by ' + Math.round(Math.abs(e1 - e2)) + ' miles' };
+  }
+  if (e1 !== null) return { v: Math.round(clamp(e1)), src: 'filled', warn: 'filled from the reading before it only' };
+  if (e2 !== null) return { v: Math.round(clamp(e2)), src: 'filled', warn: 'filled from the reading after it only' };
+  return null;
+}
+
+function dmCompute(dk, quick) {
+  const state = dmState(dk);
+  const all = dmStops(dk);
+  const home = dmStartGet();
+  let picked = state.pick ? all.filter(s => state.pick.indexOf(s.id) !== -1)
+    : all.filter(s => s.cats.some(c => DM_WORK.indexOf(c) !== -1) && !(home && dmNear(s, home, DM_NEAR_M)));
+  const missing = [];
+  state.extra.forEach(x => {
+    if (!isFinite(x.lat)) { missing.push(x); return; }
+    const hit = all.find(s => dmNear(s, x, DM_NEAR_M));
+    if (hit) { if (picked.indexOf(hit) === -1) picked.push(hit); } else missing.push(x);
+  });
+  picked.sort((a, b) => a.t0 - b.t0);
+  const out = { dk: dk, state: state, all: all, stops: picked, missing: missing, warns: [] };
+  const rs = dmReadings();
+  const pairs = quick ? [] : dmPairs();
+  picked.forEach(s => { s.odo = dmOdoAt(s, rs, pairs); });
+  if (quick) return out;
+  const p = dmStartGet();
+  out.startPoint = p;
+  if (!picked.length) { out.warns.push('No tickets picked for this day.'); return out; }
+  const first = picked[0], last = picked[picked.length - 1];
+  let start = null, route = 0, learned = 0, legs = 0;
+  if (p) {
+    const atStart = rs.filter(x => x.pos && dmNear(x, p, DM_NEAR_M) && localDay(x.t) === dk && x.t < first.t0).pop();
+    const d0 = dmDist(p, first, pairs);
+    if (atStart) start = { v: atStart.r, src: 'reading' };
+    else if (first.odo) start = { v: Math.round(first.odo.v - d0.mi), src: 'filled' };
+    route += d0.mi; legs++; if (d0.src === 'learned') learned++;
+  } else out.warns.push('Set a day start point so each day starts there.');
+  for (let i = 1; i < picked.length; i++) {
+    const d = dmDist(picked[i - 1], picked[i], pairs);
+    route += d.mi; legs++; if (d.src === 'learned') learned++;
+  }
+  out.start = start;
+  out.end = last.odo ? { v: last.odo.v, src: last.odo.src } : null;
+  out.route = Math.round(route);
+  out.learned = learned; out.legs = legs;
+  out.odoMiles = start && out.end ? out.end.v - start.v : null;
+  out.suggest = out.odoMiles !== null ? Math.max(0, Math.min(out.route + dmMargin(), out.odoMiles)) : out.route + dmMargin();
+  picked.forEach(s => { if (!s.odo) out.warns.push('No odometer reading anywhere near ' + s.label + '.'); else if (s.odo.warn) out.warns.push(s.label + ': ' + s.odo.warn + '.'); });
+  missing.forEach(x => out.warns.push('Ticket with no pin that day: ' + x.addr + '.'));
+  return out;
+}
+
+function dmDays() {
+  const days = {};
+  entries.forEach(e => {
+    if (!e.timestamp) return;
+    if (e.category === 'mileday' && e.context) { days[e.context.slice(8)] = true; return; }
+    if (hasPos(e) && DM_SKIP.indexOf(e.category) === -1 && DM_WORK.indexOf(e.category) !== -1) days[localDay(e.timestamp)] = true;
+  });
+  return Object.keys(days).sort().reverse().slice(0, 45);
+}
+
+function showDailyMiles() {
+  const panel = document.getElementById('panel');
+  const p = dmStartGet();
+  let html = '<h2>DAILY MILES</h2>';
+  html += '<div class="meta-line">Each workday gets a start, an end and business miles. Tap a day to check it and confirm it.</div>';
+  dmDays().forEach(dk => {
+    const s = dmState(dk);
+    const line = s.locked ? 'Start ' + s.start + ', end ' + s.end + ', business ' + s.business + ', confirmed' : 'not confirmed yet';
+    html += '<div class="mi-row" data-dm="' + dk + '"' + (s.locked ? ' style="border-left:4px solid #2e9e4f;padding-left:8px;"' : '') + '><b>' + escapeHtml(dmDayLabel(dk)) + '</b><br><span class="meta-line">' + escapeHtml(line) + '</span></div>';
+  });
+  html += '<div class="question">Day start point</div>';
+  html += '<div class="meta-line">' + (p ? escapeHtml(p.label || 'Set') + '. Every day starts here before the first ticket.' : 'Not set. Every day starts here before the first ticket.') + '</div>';
+  html += '<input type="text" id="dmStartAddr" placeholder="Street address, city, state" autocomplete="off">';
+  html += '<div class="panel-actions"><button class="secondary" id="dmStartAddrBtn">USE THIS ADDRESS</button><button class="secondary" id="dmStartHereBtn">USE WHERE I AM</button></div>';
+  html += '<div class="question">Extra miles added to the route</div>';
+  html += '<input type="text" id="dmMargin" inputmode="decimal" value="' + dmMargin() + '">';
+  html += '<div class="panel-actions"><button id="dmCsvBtn">SAVE SPREADSHEET</button><button class="secondary" id="dmClose">CLOSE</button></div>';
+  panel.innerHTML = html;
+  panel.scrollTop = 0;
+  panel.classList.add('open');
+  panel.querySelectorAll('[data-dm]').forEach(el => el.addEventListener('click', () => showDailyMilesDay(el.getAttribute('data-dm'))));
+  document.getElementById('dmClose').addEventListener('click', closePanel);
+  document.getElementById('dmMargin').addEventListener('change', ev => {
+    const v = parseFloat(ev.target.value);
+    try { localStorage.setItem(DM_MARGIN_KEY, String(isFinite(v) && v >= 0 ? v : 2)); } catch (e) {}
+    setStatus('extra route miles saved');
+  });
+  document.getElementById('dmStartHereBtn').addEventListener('click', async () => {
+    const me = typeof mySpot === 'function' ? mySpot() : null;
+    if (!me) { setStatus('no location yet, turn on Location and try again'); return; }
+    await dmStartSet({ lat: Math.round(me.lat * 1e5) / 1e5, lon: Math.round(me.lon * 1e5) / 1e5, label: 'Where you stood when you set it' });
+    setStatus('day start point saved for all your phones');
+    showDailyMiles();
+  });
+  document.getElementById('dmStartAddrBtn').addEventListener('click', async () => {
+    const q = document.getElementById('dmStartAddr').value.trim();
+    if (!q) { setStatus('type the address first'); return; }
+    setStatus('looking up the address');
+    try {
+      const g = await geocodeSmart(q);
+      await dmStartSet({ lat: g.lat, lon: g.lon, label: q });
+      setStatus('day start point saved for all your phones');
+      showDailyMiles();
+    } catch (e) { setStatus('could not find that address, add the city and state'); }
+  });
+  document.getElementById('dmCsvBtn').addEventListener('click', () => {
+    const rows = [['date', 'start mileage', 'end mileage', 'odometer miles', 'business miles']];
+    dmDays().slice().reverse().forEach(dk => {
+      const s = dmState(dk);
+      if (s.locked) rows.push([dk, s.start, s.end, s.end - s.start, s.business]);
+    });
+    if (rows.length < 2) { setStatus('confirm a day first'); return; }
+    saveTextFile('field-twin-daily-miles-' + localDay(new Date()) + '.csv', 'text/csv', rows.map(r => r.map(csvCell).join(',')).join('\n'));
+  });
+}
+
